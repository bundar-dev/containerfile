# Build a release in the official Elixir image, run it on Debian slim.
# Override versions at build time, e.g. --build-arg ELIXIR_VERSION=1.18
ARG ELIXIR_VERSION={{.versions.elixir}}
ARG OTP_VERSION={{.versions.otp}}
ARG DEBIAN_VERSION={{.debian}}

ARG BUILDER_IMAGE="docker.io/library/elixir:${ELIXIR_VERSION}-otp-${OTP_VERSION}-slim"
ARG RUNNER_IMAGE="docker.io/library/debian:${DEBIAN_VERSION}-slim"

FROM ${BUILDER_IMAGE} AS builder

# install build dependencies
{{apt .buildPackages}}

WORKDIR /app

# install hex + rebar
RUN mix local.hex --force && mix local.rebar --force

ENV MIX_ENV="prod"

# install mix dependencies
{{if .lock}}
COPY mix.exs mix.lock ./
{{else}}
COPY mix.exs ./
{{end}}
{{if .umbrella}}
COPY apps apps
{{end}}
RUN mix deps.get --only $MIX_ENV
RUN mkdir config

{{if .configFiles}}
# copy compile-time config files before we compile dependencies
# to ensure any relevant config change will trigger the dependencies
# to be re-compiled.
COPY {{join .configFiles " "}} config/
{{end}}
RUN mix deps.compile
{{if .assetsSetup}}

RUN mix assets.setup
{{end}}

{{if .priv}}
COPY priv priv
{{end}}
{{if .lib}}
COPY lib lib
{{end}}

# compile the release
RUN mix compile
{{if .assets}}

{{if eq .webDir "."}}
COPY assets assets
{{end}}
{{if .npmInstall}}
RUN {{.npmInstall}}
{{end}}
{{if .assetsDeploy}}

# compile assets
{{if eq .webDir "."}}
RUN mix assets.deploy
{{else}}
RUN cd {{.webDir}} && mix assets.deploy
{{end}}
{{end}}
{{end}}

{{if .runtimeConfig}}
# changes to config/runtime.exs don't require recompiling the code
COPY config/runtime.exs config/
{{end}}

{{if .rel}}
COPY rel rel
{{end}}
RUN mix release{{.releaseArg}}

# start a new build stage so that the final image will only contain
# the compiled release and other runtime necessities
FROM ${RUNNER_IMAGE} AS runner

{{apt .runtimePackages}}

# set the locale
RUN sed -i '/en_US.UTF-8/s/^# //g' /etc/locale.gen && locale-gen

ENV LANG=en_US.UTF-8 \
    LANGUAGE=en_US:en \
    LC_ALL=en_US.UTF-8

WORKDIR "/app"
RUN chown nobody /app

# set runner ENV
ENV MIX_ENV="prod"
{{env .env}}

# only copy the final release from the build stage
COPY --from=builder --chown=nobody:root /app/_build/${MIX_ENV}/rel/{{.release}} ./

USER nobody
{{if .port}}

EXPOSE {{.port}}
{{end}}

CMD {{exec .cmd}}
